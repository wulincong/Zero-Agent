# ==========================================================================
# 环境变量示例（复制为 .env 使用）
# --------------------------------------------------------------------------
# 本文件只放【密钥】和【临时覆盖项】。
# 常规可调参数请改 config.toml（超时、上下文预算、渲染宽度等）。
# 环境变量优先级高于 config.toml，适合临时覆盖而不改文件。
# ==========================================================================

# ===== 模型密钥（必填）=====
# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY="sk-xxxx"

# Google Gemini（https://aistudio.google.com/apikey）
# 使用官方 OpenAI 兼容端点，无需额外依赖
GEMINI_API_KEY="AIza-xxxx"

# ===== 可选：临时覆盖 config.toml 中的配置 =====
# 默认模型档案（对应 config.toml 的 [model].default_profile）
# AGENT_DEFAULT_MODEL=deepseek

# 调用超时（秒），对应 [timeout] 段。0 表示不限制。
# AGENT_FIRST_BYTE_TIMEOUT=60
# AGENT_TOTAL_TIMEOUT=300

# 上下文预算，对应 [context] 段。0 表示不限制。
# AGENT_CONTEXT_MAX_CHARS=400000
# AGENT_CONTEXT_KEEP_RECENT=12

# 渲染宽度上限（列），对应 [cli].render_width。0 表示不限制。
# AGENT_RENDER_WIDTH=100

# shell 命令超时（秒），对应 [shell].timeout
# AGENT_SHELL_TIMEOUT=180
