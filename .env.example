# ===== 模型密钥配置 =====
# 默认模型由 AGENT_DEFAULT_MODEL 决定（不设则为 deepseek）
# AGENT_DEFAULT_MODEL=deepseek

# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY="sk-xxxx"

# Google Gemini（https://aistudio.google.com/apikey）
# 使用官方 OpenAI 兼容端点，无需额外依赖
GEMINI_API_KEY="AIza-xxxx"

# ===== 调用超时（可选，单位：秒）=====
# 首字节超时：连接建立后多久没收到任何数据就判定为挂起。
# 用于捕获"连上了但服务端不吐字"的场景，避免无限等待。设为 0 表示不限制。
# AGENT_FIRST_BYTE_TIMEOUT=60

# 整体超时：单次模型调用的最长等待时间，兜底防止无限等待。设为 0 表示不限制。
# AGENT_TOTAL_TIMEOUT=300

# ===== 上下文预算（可选）=====
# 超过该字符数时从最旧处成组丢弃消息，防止撑爆模型上下文窗口。0 表示不限制。
# AGENT_CONTEXT_MAX_CHARS=400000
# AGENT_CONTEXT_KEEP_RECENT=12
